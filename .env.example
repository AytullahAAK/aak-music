# Jamendo read-only API Client ID. Keep server-side; do not rename to VITE_JAMENDO_CLIENT_ID.
# Create one application at https://devportal.jamendo.com/ after confirming your usage terms.
JAMENDO_CLIENT_ID=

# Optional. Enables server-side YouTube Data API search; never expose as a VITE_ variable.
# Enable YouTube Data API v3 in Google Cloud, create an API key, and restrict it to this server/application.
YOUTUBE_DATA_API_KEY=

# Optional. Enables server-side Spotify catalog metadata search only.
# Create an app in https://developer.spotify.com/dashboard/ and keep both values server-side.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple/iTunes song search is public and does not require a key.
