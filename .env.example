# YouTube Data API v3. Store in the server environment only.
# Create a Google Cloud project, enable YouTube Data API v3, and restrict this key to the API.
YOUTUBE_DATA_API_KEY= AIzaSyANrSEOkEO_o1jzpMeRUSuc_k3zfZ_Xt64

# Spotify Web API catalogue metadata search (server to server).
# Create an app at https://developer.spotify.com/dashboard/.
# The Client ID is public; the Client Secret must stay server-side.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple MusicKit on the Web. Private signing key stays server-side.
# Apple Developer MusicKit key details are available in Certificates, Identifiers & Profiles.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Base64-encode the complete .p8 PEM file; never put the raw private key in frontend variables.
APPLE_MUSIC_PRIVATE_KEY_BASE64=
# Comma-separated exact origins, including scheme and port, e.g. localhost + your production domain.
APPLE_MUSIC_ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.example

# Optional AI-assisted transcription and translation. Server only; never prefix with VITE_.
# Create an API key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=
OPENAI_LYRICS_MODEL=gpt-6-luna
